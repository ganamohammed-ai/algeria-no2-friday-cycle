    "script": "scripts/download/era5_download.py",
    "label": "Era5 Download",
    "group": "Downloads",
    "arguments": [
      {
        "flag": "--years",
        "type": "string",
        "required": false,
        "default": "2019-2025",
        "choices": [],
        "help": "e.g. 2019-2025 or 2024 or 2020,2021",
        "nargs": null
      },
      {
        "flag": "--months",
        "type": "string",
        "required": false,
        "default": "1-12",
        "choices": [],
        "help": "used with --chunk month, e.g. 1-12 or 1 or 12,1,2",
        "nargs": null
      },
      {
        "flag": "--sites",
        "type": "string",
        "required": false,
        "default": "default",
        "choices": [],
        "help": "",
        "nargs": null
      },
      {
        "flag": "--half-box",
        "type": "float",
        "required": false,
        "default": null,
        "choices": [],
        "help": "",
        "nargs": null
      },
      {
        "flag": "--per-site",
        "type": "bool",
        "required": false,
        "default": null,
        "choices": [],
        "help": "one small request per site instead of one box covering all sites",
        "nargs": null
      },
      {
        "flag": "--outdir",
        "type": "output",
        "required": false,
        "default": "era5",
        "choices": [],
        "help": "",
        "nargs": null
      },
      {
        "flag": "--skip-pressure",
        "type": "bool",
        "required": false,
        "default": null,
        "choices": [],
        "help": "single-level variables only",
        "nargs": null
      },
      {
        "flag": "--only",
        "type": "enum",
        "required": false,
        "default": null,
        "choices": [
          "sl",
          "pl"
        ],
        "help": "download only the single-level (sl) or pressure-level (pl) files",
        "nargs": null
      },
      {
        "flag": "--chunk",
        "type": "enum",
        "required": false,
        "default": "month",
        "choices": [
          "month",
          "quarter",
          "year"
        ],
        "help": "months per request. year / quarter = far fewer requests (each waits in the CDS queue only once); a request the CDS finds too large is split automatically",
        "nargs": null
      }
    ]
  },
  {
    "id": "tropomi_download",
    "script": "scripts/download/tropomi_download.py",
    "label": "Tropomi Download",
    "group": "Downloads",
    "arguments": [
      {
        "flag": "--start",
        "type": "string",
        "required": false,
        "default": "2019-08-07",
        "choices": [],
        "help": "first day, YYYY-MM-DD (default 2019-08-07)",
        "nargs": null
      },
      {
        "flag": "--end",
        "type": "string",
        "required": false,
        "default": "2025-12-31",
        "choices": [],
        "help": "last day, YYYY-MM-DD (default 2025-12-31)",
        "nargs": null
      },
      {
        "flag": "--sites",
        "type": "string",
        "required": false,
        "default": "default",
        "choices": [],
        "help": "comma list, e.g. algiers,constantine (default: all)",
        "nargs": null
      },
      {
        "flag": "--half-box",
        "type": "float",
        "required": false,
        "default": null,
        "choices": [],
        "help": "box radius in degrees of latitude",
        "nargs": null
      },
      {
        "flag": "--min-overlap",
        "type": "float",
        "required": false,
        "default": 0.4,
        "choices": [],
        "help": "skip orbit files whose footprint covers less than this fraction of a site box or misses the site centre (default 0.4; 0 = keep everything)",
        "nargs": null
      },
      {
        "flag": "--workers",
        "type": "int",
        "required": false,
        "default": 3,
        "choices": [],
        "help": "parallel downloads (default 3; the server allows at most 4)",
        "nargs": null
      },
      {
        "flag": "--outdir",
        "type": "output",
        "required": false,
        "default": "tropomi_clips",
        "choices": [],
        "help": "folder for the cut pieces",
        "nargs": null
      },
      {
        "flag": "--rawdir",
        "type": "string",
        "required": false,
        "default": "tropomi_raw_tmp",
        "choices": [],
        "help": "temporary folder for the big files",
        "nargs": null
      },
      {
        "flag": "--no-ak",
        "type": "bool",
        "required": false,
        "default": null,
        "choices": [],
        "help": "do not keep averaging kernels (smaller output)",
        "nargs": null
      },
      {
        "flag": "--keep-raw",
        "type": "bool",
        "required": false,
        "default": null,
        "choices": [],
        "help": "do not delete the big original files",
        "nargs": null
      },
      {
        "flag": "--count-only",
        "type": "bool",
        "required": false,
        "default": null,
        "choices": [],
        "help": "only count files and size, download nothing",
        "nargs": null
      },
      {
        "flag": "--inspect",
        "type": "bool",
        "required": false,
        "default": null,
        "choices": [],
        "help": "download ONE file and print its variables",
        "nargs": null
      }
    ]
  },
